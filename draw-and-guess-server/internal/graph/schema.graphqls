# Draw and Guess Game - GraphQL Schema

scalar Time

# ============================================
# User Types
# ============================================

type User {
  id: ID!
  username: String!
  displayName: String!
  email: String
  avatarUrl: String
  createdAt: Time!
  updatedAt: Time!
}

input CreateUserInput {
  username: String!
  displayName: String!
  email: String
  avatarUrl: String
}

input UpdateUserInput {
  displayName: String
  email: String
  avatarUrl: String
}

# ============================================
# Game Room Types
# ============================================

enum GameType {
  OX
  QA
  WORDCHAIN
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
}

type Player {
  username: String!
  displayName: String!
  score: Int!
  isReady: Boolean!
}

type GameRoom {
  id: ID!
  name: String!
  gameType: GameType!
  status: GameStatus!
  currentRound: Int!
  totalRounds: Int!
  players: [Player!]!
  maxPlayers: Int!
  hostUsername: String!
  usedQuizIds: [String!]!
  isPrivate: Boolean!
  password: String
  createdAt: Time!
}

input CreateGameRoomInput {
  name: String!
  gameType: GameType!
  maxPlayers: Int!
  totalRounds: Int!
  hostUsername: String!
  isPrivate: Boolean
  password: String
}

input UpdateGameRoomInput {
  name: String
  maxPlayers: Int
  totalRounds: Int
  isPrivate: Boolean
  password: String
}

# ============================================
# Invitation Types
# ============================================

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

type Invitation {
  id: ID!
  roomId: ID!
  room: GameRoom!
  inviterId: ID!
  inviter: User!
  inviteeId: ID!
  invitee: User!
  status: InviteStatus!
  createdAt: Time!
  expiresAt: Time!
}

# ============================================
# Quiz Types
# ============================================

type OXQuiz {
  id: ID!
  category: String!
  difficulty: String!
  question: String!
  answer: Boolean!
  explanation: String
  usageCount: Int!
  isActive: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

type GeneralQuiz {
  id: ID!
  category: String!
  difficulty: String!
  question: String!
  options: [String!]!
  answer: Int!
  explanation: String
  imageUrl: String
  usageCount: Int!
  isActive: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

enum OXChoice {
  O
  X
}

# ============================================
# Game Config & Data Types
# ============================================

type GameConfig {
  maxPlayers: Int!
  roundDuration: Int!
  drawingTime: Int!
  guessingTime: Int!
  roundsPerGame: Int!
}

type WordchainPrompt {
  word: String!
  hint: String
}

# ============================================
# Player Stats Types
# ============================================

type PlayerStats {
  username: String!
  gameType: String!
  totalGames: Int!
  totalWins: Int!
  totalScore: Int!
  createdAt: Time!
  updatedAt: Time!
}

# ============================================
# Chat & Events Types
# ============================================

type ChatMessage {
  id: ID!
  roomId: ID!
  username: String!
  displayName: String!
  message: String!
  timestamp: Time!
}

enum GameEventType {
  PLAYER_JOINED
  PLAYER_LEFT
  PLAYER_READY
  HOST_CHANGED
  ROUND_STARTED
  ROUND_ENDED
  ANSWER_SUBMITTED
  CORRECT_ANSWER
  WRONG_ANSWER
  GAME_ENDED
}

type GameEvent {
  type: GameEventType!
  roomId: ID!
  username: String
  displayName: String
  data: String
  timestamp: Time!
}

type ErrorEvent {
  code: String!
  message: String!
  timestamp: Time!
}

# ============================================
# Queries
# ============================================

type Query {
  # User queries
  user(username: String!): User
  users: [User!]!
  
  # Game room queries
  gameRoom(id: ID!): GameRoom
  gameRooms(gameType: GameType): [GameRoom!]!
  
  # Quiz queries
  randomOXQuiz(roomId: ID): OXQuiz
  randomQAQuiz(roomId: ID): GeneralQuiz
  
  # Player stats queries
  playerStats(username: String!, gameType: String): [PlayerStats!]!
  leaderboard(gameType: String!, limit: Int): [PlayerStats!]!
  
  # Game config & data
  gameConfig: GameConfig!
  randomWordchainPrompt: WordchainPrompt!
}

# ============================================
# Mutations
# ============================================

type Mutation {
  # User mutations
  createUser(input: CreateUserInput!): User!
  updateUser(username: String!, input: UpdateUserInput!): User!
  deleteUser(username: String!): Boolean!
  
  # Game room mutations
  createGameRoom(input: CreateGameRoomInput!): GameRoom!
  updateGameRoom(roomId: ID!, input: UpdateGameRoomInput!): GameRoom!
  joinGameRoom(roomId: ID!, username: String!, password: String): GameRoom!
  leaveGameRoom(roomId: ID!, username: String!): GameRoom!
  deleteGameRoom(roomId: ID!): Boolean!
  transferHost(roomId: ID!, newHostUsername: String!): GameRoom!
  setReady(roomId: ID!, username: String!, ready: Boolean!): Boolean!
  
  # Invitation mutations
  inviteUser(roomId: ID!, inviteeUsername: String!): Invitation!
  acceptInvite(invitationId: ID!): GameRoom!
  rejectInvite(invitationId: ID!): Boolean!
  
  # Game flow mutations
  startGame(roomId: ID!): GameRoom!
  startRound(roomId: ID!): GameRoom!
  submitAnswer(roomId: ID!, username: String!, answer: String!): Boolean!
  endGame(roomId: ID!): GameRoom!
  
  # Chat mutations
  sendChat(roomId: ID!, username: String!, message: String!): ChatMessage!
}

# ============================================
# Subscriptions
# ============================================

type Subscription {
  # Lobby subscriptions
  lobbyUpdated: [GameRoom!]!
  gameRoomsUpdated: [GameRoom!]!
  
  # Room subscriptions
  gameRoomUpdated(roomId: ID!): GameRoom!
  playerJoined(roomId: ID!): Player!
  playerLeft(roomId: ID!): Player!
  playerReadyUpdated(roomId: ID!): Player!
  hostChanged(roomId: ID!): Player!
  
  # Game flow subscriptions
  gameStarted(roomId: ID!): GameRoom!
  roundStarted(roomId: ID!): GameRoom!
  roundEnded(roomId: ID!): GameRoom!
  gameEnded(roomId: ID!): GameRoom!
  
  # Chat subscriptions
  chatMessage(roomId: ID!): ChatMessage!
  
  # Event subscriptions
  gameEvent(roomId: ID!): GameEvent!
  error(roomId: ID!): ErrorEvent!
}
