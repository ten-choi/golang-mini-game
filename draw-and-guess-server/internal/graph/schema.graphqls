# Draw and Guess Game - GraphQL Schema

scalar Time

# ============================================
# User Types
# ============================================

"""
게임 플레이어 계정을 나타냅니다.
Username은 고유하며 주요 식별자로 사용됩니다.
"""
type User {
  "고유 식별자 (Snowflake ID)"
  id: ID!
  "고유 사용자명 (3-20자, 로그인 ID)"
  username: String!
  "게임 내 표시 이름 (중복 가능)"
  displayName: String!
  "선택적 이메일 주소"
  email: String
  "선택적 프로필 이미지 URL"
  avatarUrl: String
  "계정 생성 시각"
  createdAt: Time!
  "마지막 업데이트 시각"
  updatedAt: Time!
}

input CreateUserInput {
  username: String!
  displayName: String!
  email: String
  avatarUrl: String
}

input UpdateUserInput {
  displayName: String
  email: String
  avatarUrl: String
}

# ============================================
# Game Room Types
# ============================================

enum GameType {
  OX
  QA
  WORDCHAIN
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
}

type Player {
  username: String!
  displayName: String!
  score: Int!
  isReady: Boolean!
}

"""
멀티플레이어 게임 세션을 나타냅니다.
OX 퀴즈, QA 퀴즈, 끝말잇기 게임 모드를 지원합니다.
"""
type GameRoom {
  "고유 게임방 식별자 (UUID)"
  id: ID!
  "게임방 표시 이름"
  name: String!
  "게임 모드: OX, QA, 또는 WORDCHAIN"
  gameType: GameType!
  "현재 게임 상태"
  status: GameStatus!
  "현재 라운드 번호 (1부터 시작)"
  currentRound: Int!
  "총 라운드 수 (기본값: 5)"
  totalRounds: Int!
  "게임방 내 플레이어 목록"
  players: [Player!]!
  "최대 플레이어 수 (2-10명)"
  maxPlayers: Int!
  "방장 사용자명"
  hostUsername: String!
  "현재 게임에서 사용된 퀴즈 ID 목록"
  usedQuizIds: [String!]!
  "비공개방 여부"
  isPrivate: Boolean!
  "게임방 비밀번호 (비공개방만)"
  password: String
  "게임방 생성 시각"
  createdAt: Time!
}

input CreateGameRoomInput {
  name: String!
  gameType: GameType!
  maxPlayers: Int!
  totalRounds: Int!
  hostUsername: String!
  isPrivate: Boolean
  password: String
}

input UpdateGameRoomInput {
  name: String
  maxPlayers: Int
  totalRounds: Int
  isPrivate: Boolean
  password: String
}

# ============================================
# Invitation Types
# ============================================

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

type Invitation {
  id: ID!
  roomId: ID!
  room: GameRoom!
  inviterId: ID!
  inviter: User!
  inviteeId: ID!
  invitee: User!
  status: InviteStatus!
  createdAt: Time!
  expiresAt: Time!
}

# ============================================
# Quiz Types
# ============================================

"""
OX 퀴즈 (참/거짓 문제)를 나타냅니다.
OX 게임 모드에서 사용됩니다.
"""
type OXQuiz {
  "고유 퀴즈 ID (Snowflake)"
  id: ID!
  "퀴즈 카테고리 (예: 과학, 역사)"
  category: String!
  "난이도: easy, medium, hard"
  difficulty: String!
  "문제 텍스트"
  question: String!
  "정답: true 또는 false"
  answer: Boolean!
  "정답 설명 (선택사항)"
  explanation: String
  "이 퀴즈가 사용된 횟수"
  usageCount: Int!
  "퀴즈 활성화 여부"
  isActive: Boolean!
  "퀴즈 생성 시각"
  createdAt: Time!
  "마지막 업데이트 시각"
  updatedAt: Time!
}

"""
4지선다 퀴즈를 나타냅니다.
QA 게임 모드에서 사용됩니다.
"""
type GeneralQuiz {
  "고유 퀴즈 ID (Snowflake)"
  id: ID!
  "퀴즈 카테고리 (예: 수학, 지리)"
  category: String!
  "난이도: easy, medium, hard"
  difficulty: String!
  "문제 텍스트"
  question: String!
  "4개의 선택지 배열"
  options: [String!]!
  "정답 인덱스 (0-3)"
  answer: Int!
  "정답 설명 (선택사항)"
  explanation: String
  "시각적 문제를 위한 이미지 URL (선택사항)"
  imageUrl: String
  "이 퀴즈가 사용된 횟수"
  usageCount: Int!
  "퀴즈 활성화 여부"
  isActive: Boolean!
  "퀴즈 생성 시각"
  createdAt: Time!
  "마지막 업데이트 시각"
  updatedAt: Time!
}

enum OXChoice {
  O
  X
}

# ============================================
# Game Config & Data Types
# ============================================

type GameConfig {
  maxPlayers: Int!
  roundDuration: Int!
  drawingTime: Int!
  guessingTime: Int!
  roundsPerGame: Int!
}

type WordchainPrompt {
  word: String!
  hint: String
}

# ============================================
# Player Stats Types
# ============================================

type PlayerStats {
  username: String!
  gameType: String!
  totalGames: Int!
  totalWins: Int!
  totalScore: Int!
  createdAt: Time!
  updatedAt: Time!
}

# ============================================
# Chat & Events Types
# ============================================

type ChatMessage {
  id: ID!
  roomId: ID!
  username: String!
  displayName: String!
  message: String!
  timestamp: Time!
}

enum GameEventType {
  PLAYER_JOINED
  PLAYER_LEFT
  PLAYER_READY
  HOST_CHANGED
  ROUND_STARTED
  ROUND_ENDED
  ANSWER_SUBMITTED
  CORRECT_ANSWER
  WRONG_ANSWER
  GAME_ENDED
}

type GameEvent {
  type: GameEventType!
  roomId: ID!
  username: String
  displayName: String
  data: String
  timestamp: Time!
}

type ErrorEvent {
  code: String!
  message: String!
  timestamp: Time!
}

# ============================================
# Queries
# ============================================

type Query {
  # User queries
  "사용자명으로 특정 사용자 조회"
  user(username: String!): User
  "모든 사용자 목록 조회"
  users: [User!]!
  
  # Game room queries
  "게임방 ID로 특정 게임방 조회"
  gameRoom(id: ID!): GameRoom
  "모든 게임방 조회 (게임 타입으로 필터링 가능)"
  gameRooms(gameType: GameType): [GameRoom!]!
  
  # Quiz queries
  "랜덤 OX 퀴즈 조회 (이미 사용된 퀴즈 제외)"
  randomOXQuiz(roomId: ID): OXQuiz
  "랜덤 4지선다 퀴즈 조회 (이미 사용된 퀴즈 제외)"
  randomQAQuiz(roomId: ID): GeneralQuiz
  
  # Player stats queries
  "플레이어 통계 조회 (게임 타입별 필터링 가능)"
  playerStats(username: String!, gameType: String): [PlayerStats!]!
  "리더보드 상위 랭커 조회"
  leaderboard(gameType: String!, limit: Int): [PlayerStats!]!
  
  # Game config & data
  "게임 설정 정보 조회"
  gameConfig: GameConfig!
  "끝말잇기용 랜덤 단어 조회"
  randomWordchainPrompt: WordchainPrompt!
}

# ============================================
# Mutations
# ============================================

type Mutation {
  # User mutations
  "새 사용자 계정 생성"
  createUser(input: CreateUserInput!): User!
  "사용자 프로필 정보 수정"
  updateUser(username: String!, input: UpdateUserInput!): User!
  "사용자 계정 삭제"
  deleteUser(username: String!): Boolean!
  
  # Game room mutations
  "새 게임방 생성 (생성자가 방장이 됨)"
  createGameRoom(input: CreateGameRoomInput!): GameRoom!
  "게임방 설정 변경 (방장만 가능)"
  updateGameRoom(roomId: ID!, input: UpdateGameRoomInput!): GameRoom!
  "게임방 입장 (비공개방은 비밀번호 필요)"
  joinGameRoom(roomId: ID!, username: String!, password: String): GameRoom!
  "게임방 퇴장 (마지막 플레이어 퇴장 시 방 자동 삭제)"
  leaveGameRoom(roomId: ID!, username: String!): GameRoom!
  "게임방 삭제 (방장만 가능)"
  deleteGameRoom(roomId: ID!): Boolean!
  "방장 권한 양도 (방장만 가능)"
  transferHost(roomId: ID!, newHostUsername: String!): GameRoom!
  "준비 상태 변경"
  setReady(roomId: ID!, username: String!, ready: Boolean!): Boolean!
  
  # Invitation mutations
  "게임방에 사용자 초대"
  inviteUser(roomId: ID!, inviteeUsername: String!): Invitation!
  "초대 수락 및 게임방 입장"
  acceptInvite(invitationId: ID!): GameRoom!
  "초대 거절"
  rejectInvite(invitationId: ID!): Boolean!
  
  # Game flow mutations
  "게임 시작 (방장만 가능, 최소 2명 필요)"
  startGame(roomId: ID!): GameRoom!
  "다음 라운드 시작 (서버가 자동 호출)"
  startRound(roomId: ID!): GameRoom!
  "퀴즈 정답 제출 (OX: 'true'/'false', QA: '0'-'3')"
  submitAnswer(roomId: ID!, username: String!, answer: String!): Boolean!
  "게임 종료 (방장만 가능)"
  endGame(roomId: ID!): GameRoom!
  
  # Chat mutations
  "채팅 메시지 전송"
  sendChat(roomId: ID!, username: String!, message: String!): ChatMessage!
}

# ============================================
# Subscriptions (Real-time Updates via WebSocket)
# ============================================

type Subscription {
  # Lobby subscriptions
  "로비 게임방 목록 실시간 업데이트 구독"
  lobbyUpdated: [GameRoom!]!
  "게임 타입별 게임방 목록 실시간 업데이트 구독"
  gameRoomsUpdated: [GameRoom!]!
  
  # Room subscriptions
  "특정 게임방 상태 변경 실시간 구독"
  gameRoomUpdated(roomId: ID!): GameRoom!
  "플레이어 입장 이벤트 실시간 구독"
  playerJoined(roomId: ID!): Player!
  "플레이어 퇴장 이벤트 실시간 구독"
  playerLeft(roomId: ID!): Player!
  "플레이어 준비 상태 변경 실시간 구독"
  playerReadyUpdated(roomId: ID!): Player!
  "방장 변경 이벤트 실시간 구독"
  hostChanged(roomId: ID!): Player!
  
  # Game flow subscriptions
  "게임 시작 이벤트 실시간 구독"
  gameStarted(roomId: ID!): GameRoom!
  "라운드 시작 이벤트 실시간 구독 (새 퀴즈 포함)"
  roundStarted(roomId: ID!): GameRoom!
  "라운드 종료 이벤트 실시간 구독 (점수 포함)"
  roundEnded(roomId: ID!): GameRoom!
  "게임 종료 이벤트 실시간 구독 (최종 결과 포함)"
  gameEnded(roomId: ID!): GameRoom!
  
  # Chat subscriptions
  "채팅 메시지 실시간 구독"
  chatMessage(roomId: ID!): ChatMessage!
  
  # Event subscriptions
  "모든 게임 이벤트 실시간 구독 (정답/오답 등)"
  gameEvent(roomId: ID!): GameEvent!
  "에러 이벤트 실시간 구독"
  error(roomId: ID!): ErrorEvent!
}
