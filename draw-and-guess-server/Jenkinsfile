pipeline {
    agent any

    environment {
        // 1. 접속 정보 (SSH)
        MANAGE_HOST = "www-web@manage-server.coconefk.jp"
        TARGET_HOST = "www-web@vpocket-alpha-ap-0.coconefk"

        // 2. 쿠버네티스 리소스 정보
        NAMESPACE    = 'data'
        DEPLOY_NAME  = "go-server-app-deployment"
        SVC_NAME     = "go-server-service"
        GHCR_CRED_ID = 'quiz-github-pat-for-ghcr'
        IMAGE_NAME   = "ghcr.io/yoru-choi/go-server-app:v1.0"

        // 3. 깃허브 및 파일 경로
        GIT_URL = "https://github.com/yoru-choi/golang-mini-game.git"
        BRANCH  = "dev"

        DEPLOY_YAML   = "draw-and-guess-server/deployments/k8s/deployment.yaml"
        SERVICE_YAML  = "draw-and-guess-server/deployments/k8s/service.yaml"

        // MongoDB
        MONGODB_YAML     = "draw-and-guess-server/deployments/k8s/mongodb.yaml"
        PV_MONGODB_YAML  = "draw-and-guess-server/deployments/k8s/pv-mongodb.yaml"

        // Valkey
        VALKEY_YAML    = "draw-and-guess-server/deployments/k8s/valkey.yaml"
        PV_VALKEY_YAML = "draw-and-guess-server/deployments/k8s/pv-valkey.yaml"
    }

    stages {
        stage('0. Checkout Source') {
            steps {
                echo "[0/3] Cloning ${BRANCH} branch..."
                checkout([$class: 'GitSCM',
                    branches: [[name: "*/${BRANCH}"]],
                    userRemoteConfigs: [[url: "${GIT_URL}", credentialsId: "${GHCR_CRED_ID}"]]
                ])
            }
        }

        stage('1. Update K8s Secret') {
            steps {
                echo "[1/3] Updating Image Pull Secret..."
                withCredentials([usernamePassword(credentialsId: "${GHCR_CRED_ID}", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh """
                        ssh -i ~/.ssh/id_rsa -o StrictHostKeyChecking=no ${MANAGE_HOST} "ssh -o StrictHostKeyChecking=no ${TARGET_HOST} 'bash -s'" << EOF
                            set -e

                            kubectl get ns ${NAMESPACE} >/dev/null 2>&1 || kubectl create ns ${NAMESPACE}
                            kubectl delete secret ghcr-pull-secret -n ${NAMESPACE} --ignore-not-found
                            kubectl create secret docker-registry ghcr-pull-secret \\
                                --docker-server=ghcr.io \\
                                --docker-username='${USER}' \\
                                --docker-password='${PASS}' \\
                                -n ${NAMESPACE}

                            echo "✅ ghcr-pull-secret updated in namespace: ${NAMESPACE}"
EOF
                    """
                }
            }
        }

        stage('2. Deploy MongoDB & Valkey') {
            steps {
                script {
                    echo "[2/3] Deploying MongoDB and Valkey..."

                    if (!fileExists("${PV_MONGODB_YAML}")) error "❌ PV(MongoDB) 파일 없음: ${PV_MONGODB_YAML}"
                    if (!fileExists("${PV_VALKEY_YAML}"))  error "❌ PV(Valkey) 파일 없음: ${PV_VALKEY_YAML}"
                    if (!fileExists("${MONGODB_YAML}"))    error "❌ MongoDB 파일 없음: ${MONGODB_YAML}"
                    if (!fileExists("${VALKEY_YAML}"))     error "❌ Valkey 파일 없음: ${VALKEY_YAML}"

                    def pvMongo  = readFile(PV_MONGODB_YAML)
                    def pvValkey = readFile(PV_VALKEY_YAML)
                    def mongo    = readFile(MONGODB_YAML)
                    def valkey   = readFile(VALKEY_YAML)

                    sh """
                        ssh -i ~/.ssh/id_rsa -o StrictHostKeyChecking=no ${MANAGE_HOST} "ssh -o StrictHostKeyChecking=no ${TARGET_HOST} 'bash -s'" << EOF
                            set -e

                            echo "🧹 Cleaning up existing resources (순서: StatefulSet -> Service -> PVC -> PV)..."
                            
                            # 1. StatefulSet 삭제 (Pod가 먼저 종료되어야 PVC가 해제됨)
                            echo "  ⏳ Deleting StatefulSets..."
                            kubectl delete statefulset mongodb -n ${NAMESPACE} --ignore-not-found --timeout=60s || true
                            kubectl delete statefulset valkey  -n ${NAMESPACE} --ignore-not-found --timeout=60s || true
                            
                            # 2. Service 삭제
                            echo "  ⏳ Deleting Services..."
                            kubectl delete service mongodb -n ${NAMESPACE} --ignore-not-found --timeout=30s || true
                            kubectl delete service valkey  -n ${NAMESPACE} --ignore-not-found --timeout=30s || true

                            # 3. Pod가 완전히 종료될 때까지 대기 (최대 60초)
                            echo "  ⏳ Waiting for pods to terminate..."
                            for i in {1..12}; do
                                MONGO_PODS=\$(kubectl get pods -n ${NAMESPACE} -l app=mongodb -o name 2>/dev/null | wc -l)
                                VALKEY_PODS=\$(kubectl get pods -n ${NAMESPACE} -l app=valkey -o name 2>/dev/null | wc -l)
                                if [ "\$MONGO_PODS" -eq 0 ] && [ "\$VALKEY_PODS" -eq 0 ]; then
                                    echo "  ✅ All pods terminated"
                                    break
                                fi
                                echo "  ... waiting (attempt \$i/12) - MongoDB: \$MONGO_PODS, Valkey: \$VALKEY_PODS pods remaining"
                                sleep 5
                            done

                            # 4. PVC 삭제 (타임아웃 및 강제 삭제 옵션)
                            echo "  ⏳ Deleting PVCs..."
                            
                            # MongoDB PVC 삭제 (StatefulSet이 생성한 PVC)
                            MONGO_PVCS=\$(kubectl get pvc -n ${NAMESPACE} -l app=mongodb -o name 2>/dev/null || true)
                            if [ -n "\$MONGO_PVCS" ]; then
                                echo "  ... Deleting MongoDB PVCs: \$MONGO_PVCS"
                                kubectl delete pvc -n ${NAMESPACE} -l app=mongodb --timeout=30s --wait=false || true
                            fi
                            
                            # Valkey PVC 삭제 (volumeClaimTemplates에서 생성된 PVC)
                            kubectl delete pvc valkey-data-valkey-0 -n ${NAMESPACE} --timeout=30s --wait=false --ignore-not-found || true
                            
                            # 기타 PVC 삭제 (혹시 다른 이름으로 생성된 경우)
                            kubectl delete pvc pvc-mongodb -n ${NAMESPACE} --timeout=30s --wait=false --ignore-not-found || true
                            kubectl delete pvc mongodb-data-mongodb-0 -n ${NAMESPACE} --timeout=30s --wait=false --ignore-not-found || true

                            # PVC 삭제 대기 (최대 30초)
                            echo "  ⏳ Waiting for PVCs to be deleted..."
                            for i in {1..6}; do
                                PVCS=\$(kubectl get pvc -n ${NAMESPACE} 2>/dev/null | grep -E "mongodb|valkey" | wc -l || echo "0")
                                if [ "\$PVCS" -eq 0 ]; then
                                    echo "  ✅ All PVCs deleted"
                                    break
                                fi
                                echo "  ... waiting (attempt \$i/6) - \$PVCS PVCs remaining"
                                sleep 5
                            done

                            # 5. PV 삭제 (타임아웃 추가)
                            echo "  ⏳ Deleting PVs..."
                            kubectl delete pv pv-mongodb --timeout=30s --ignore-not-found || {
                                echo "  ⚠️  PV pv-mongodb deletion timed out, forcing removal..."
                                kubectl patch pv pv-mongodb -p '{"metadata":{"finalizers":null}}' 2>/dev/null || true
                            }
                            kubectl delete pv valkey-pv-0 --timeout=30s --ignore-not-found || {
                                echo "  ⚠️  PV valkey-pv-0 deletion timed out, forcing removal..."
                                kubectl patch pv valkey-pv-0 -p '{"metadata":{"finalizers":null}}' 2>/dev/null || true
                            }

                            echo "  ⏳ Final cleanup verification..."
                            sleep 5

                            echo "📦 Creating PersistentVolumes..."
                            cat << 'PV_MG_EOF' | kubectl apply -f -
${pvMongo}
PV_MG_EOF

                            cat << 'PV_VK_EOF' | kubectl apply -f -
${pvValkey}
PV_VK_EOF

                            echo "⏳ Waiting for PVs to be available..."
                            sleep 5

                            # PV 상태 확인
                            echo "--- PV Status ---"
                            kubectl get pv pv-mongodb -o wide 2>/dev/null || echo "⚠️  PV pv-mongodb not found"
                            kubectl get pv valkey-pv-0 -o wide 2>/dev/null || echo "⚠️  PV valkey-pv-0 not found"

                            echo "🗄️ Deploying MongoDB..."
                            cat << 'MG_EOF' | kubectl apply -f -
${mongo}
MG_EOF

                            echo "💾 Deploying Valkey..."
                            cat << 'VK_EOF' | kubectl apply -f -
${valkey}
VK_EOF

                            echo "⏳ Waiting for PVCs to be bound (max 30s)..."
                            sleep 10
                            
                            # PVC 상태 확인
                            echo "--- PVC Status ---"
                            kubectl get pvc -n ${NAMESPACE}
                            
                            # PV-PVC 바인딩 확인
                            echo "--- PV-PVC Binding ---"
                            kubectl get pv pv-mongodb -o jsonpath='{.status.phase}' 2>/dev/null && echo " - pv-mongodb" || echo "pv-mongodb: N/A"
                            kubectl get pvc -n ${NAMESPACE} -o name 2>/dev/null | while read pvc; do
                                PVC_NAME=\$(basename "\$pvc")
                                PHASE=\$(kubectl get pvc "\$PVC_NAME" -n ${NAMESPACE} -o jsonpath='{.status.phase}' 2>/dev/null)
                                echo "\$PHASE - \$PVC_NAME"
                            done

                            echo "⏳ Waiting for database pods to be ready (max 120s)..."
                            
                            # MongoDB 대기
                            if ! kubectl wait --for=condition=ready pod -l app=mongodb -n ${NAMESPACE} --timeout=120s 2>/dev/null; then
                                echo "❌ MongoDB not ready - Debug Info:"
                                kubectl get pods -n ${NAMESPACE} -l app=mongodb
                                kubectl describe pod -l app=mongodb -n ${NAMESPACE} | tail -n 50
                                kubectl get events -n ${NAMESPACE} --sort-by='.lastTimestamp' | tail -n 20
                                exit 1
                            fi
                            
                            # Valkey 대기
                            if ! kubectl wait --for=condition=ready pod -l app=valkey -n ${NAMESPACE} --timeout=120s 2>/dev/null; then
                                echo "❌ Valkey not ready - Debug Info:"
                                kubectl get pods -n ${NAMESPACE} -l app=valkey
                                kubectl describe pod -l app=valkey -n ${NAMESPACE} | tail -n 50
                                exit 1
                            fi

                            echo "✅ Databases are ready!"
                            kubectl get pods -n ${NAMESPACE} -l app=mongodb
                            kubectl get pods -n ${NAMESPACE} -l app=valkey
                            kubectl get pvc -n ${NAMESPACE}
                            kubectl get pv | grep -E "pv-mongodb|valkey-pv" || true
EOF
                    """
                }
            }
        }

        stage('3. Deploy Application') {
            steps {
                script {
                    echo "[3/3] Deploying Go Application..."

                    if (!fileExists(DEPLOY_YAML) || !fileExists(SERVICE_YAML)) {
                        error "❌ Application YAML 파일 없음: ${DEPLOY_YAML}, ${SERVICE_YAML}"
                    }

                    def deployContent  = readFile(DEPLOY_YAML)
                    def serviceContent = readFile(SERVICE_YAML)

                    sh """
                        ssh -i ~/.ssh/id_rsa -o StrictHostKeyChecking=no ${MANAGE_HOST} "ssh -o StrictHostKeyChecking=no ${TARGET_HOST} 'bash -s'" << EOF
                            set -e

                            echo "🔄 Deleting existing deployment (if any)..."
                            kubectl delete deployment ${DEPLOY_NAME} -n ${NAMESPACE} --ignore-not-found --timeout=60s

                            echo "🚀 Deploying Application..."
                            cat << 'DEPLOY_EOF' | kubectl apply -f -
${deployContent}
DEPLOY_EOF

                            cat << 'SVC_EOF' | kubectl apply -f -
${serviceContent}
SVC_EOF

                            echo "⏳ Waiting for deployment rollout (max 180s)..."
                            if ! kubectl rollout status deployment/${DEPLOY_NAME} -n ${NAMESPACE} --timeout=180s; then
                                echo "❌ Deployment rollout failed - Debug Info:"
                                kubectl get pods -n ${NAMESPACE} -l app=go-server
                                kubectl describe pod -l app=go-server -n ${NAMESPACE} | tail -n 50
                                kubectl logs -l app=go-server -n ${NAMESPACE} --tail=50 || true
                                exit 1
                            fi

                            echo "--- Application Status ---"
                            kubectl get deployment ${DEPLOY_NAME} -n ${NAMESPACE}
                            kubectl get svc ${SVC_NAME} -n ${NAMESPACE}
                            kubectl get pods -n ${NAMESPACE} -l app=go-server

                            echo ""
                            echo "✅ Deployment Complete!"

                            NODE_IP=\$(kubectl get node -o wide 2>/dev/null | awk 'NR==2{print \$6}')
                            if [ -z "\$NODE_IP" ]; then
                              NODE_IP="<NODE-IP>"
                            fi

                            echo "📍 Service URL: http://\$NODE_IP:30080"
                            echo "📍 GraphQL:    http://\$NODE_IP:30080/api/v1/graphql"
EOF
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ 배포 성공! 서버가 정상적으로 기동되었습니다."
            echo "📍 GraphQL Playground: http://<SERVER-IP>:30080/api/v1/graphql"
        }
        failure {
            echo "❌ 배포 실패. 아래 명령어로 디버깅하세요:"
            echo ""
            echo "전체 상태 확인:"
            echo "  kubectl get all -n data"
            echo ""
            echo "PV/PVC 확인:"
            echo "  kubectl get pv"
            echo "  kubectl get pvc -n data"
            echo ""
            echo "Pod 상태:"
            echo "  kubectl get pods -n data"
            echo "  kubectl describe pod <pod-name> -n data"
            echo "  kubectl logs <pod-name> -n data"
            echo ""
            echo "최근 이벤트:"
            echo "  kubectl get events -n data --sort-by='.lastTimestamp' | tail -n 20"
            echo ""
            echo "강제 정리 (필요시):"
            echo "  kubectl delete statefulset mongodb valkey -n data --force --grace-period=0"
            echo "  kubectl patch pvc <pvc-name> -n data -p '{\"metadata\":{\"finalizers\":null}}'"
            echo "  kubectl patch pv <pv-name> -p '{\"metadata\":{\"finalizers\":null}}'"
        }
    }
}
