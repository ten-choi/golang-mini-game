# Draw and Guess Game GraphQL Schema

type User {
  id: ID!
  username: String!
  email: String!
  createdAt: String!
  updatedAt: String!
}

type Player {
  userId: String!
  username: String!
  score: Int!
  isReady: Boolean!
}

type GameRoom {
  id: ID!
  name: String!
  hostId: String!
  players: [Player!]!
  maxPlayers: Int!
  currentRound: Int!
  totalRounds: Int!
  status: String!
  createdAt: String!
  updatedAt: String!
}

type Quiz {
  id: ID!
  type: String!
  category: String
  difficulty: String!
  question: String!
  answer: String
  hint: String
  explanation: String
  imageUrl: String
  usageCount: Int!
  isActive: Boolean!
  createdAt: String!
  updatedAt: String!
}

type Query {
  # User queries
  user(id: ID!): User
  
  # Game room queries
  gameRooms: [GameRoom!]!
  gameRoom(id: ID!): GameRoom
  
  # Quiz queries
  quizzes(type: String, difficulty: String, limit: Int): [Quiz!]!
  quiz(id: ID!): Quiz
}

input CreateUserInput {
  username: String!
  email: String!
}

input UpdateUserInput {
  username: String
  email: String
}

input CreateGameRoomInput {
  name: String!
  hostId: String!
  maxPlayers: Int!
  totalRounds: Int!
}

input UpdateGameRoomInput {
  name: String
  maxPlayers: Int
  totalRounds: Int
}

input CreateQuizInput {
  type: String!
  category: String
  difficulty: String!
  question: String!
  answer: String!
  hint: String
  explanation: String
  imageUrl: String
}

type Mutation {
  # User mutations
  createUser(input: CreateUserInput!): User!
  updateUser(id: ID!, input: UpdateUserInput!): User!
  
  # Game room mutations
  createGameRoom(input: CreateGameRoomInput!): GameRoom!
  updateGameRoom(id: ID!, input: UpdateGameRoomInput!): GameRoom!
  deleteGameRoom(id: ID!): Boolean!
  joinGameRoom(roomId: ID!, userId: String!, username: String!): GameRoom!
  leaveGameRoom(roomId: ID!, userId: String!): GameRoom!
  startGame(roomId: ID!): GameRoom!
  
  # Quiz mutations
  createQuiz(input: CreateQuizInput!): Quiz!
  updateQuiz(id: ID!, isActive: Boolean): Quiz!
  deleteQuiz(id: ID!): Boolean!
}
