# Server Configuration
SERVER_PORT=8080
GIN_MODE=debug

# Database Configuration (Docker Compose on 10.33.255.96)
# Root 계정 사용 (docker-compose.yml의 MONGO_INITDB_ROOT_USERNAME)
# authSource=admin: root 계정은 admin DB에 저장됨
# database 이름은 MONGO_DB로 분리 (중복 방지)
# 주의: ? 앞에 / 필수! (MongoDB URI 형식)
MONGO_URI=mongodb://root:password@10.33.255.96:56061/?authSource=admin
MONGO_DB=draw_and_guess_db

# Cache Configuration (Docker Compose on 10.33.255.96)
# docker-compose.yml의 --requirepass 값과 일치
VALKEY_ADDR=10.33.255.96:56062
VALKEY_PASSWORD=game123
