# Environment variables for Docker Compose
# Copy this to .env and update with your values

# MongoDB Configuration
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=your_secure_root_password_change_me
MONGO_APP_USER=admin
MONGO_APP_PASSWORD=password

# Valkey (Redis) Configuration
VALKEY_PASSWORD=your_valkey_password_change_me

# Application Configuration (for Go server)
SERVER_PORT=8080
MONGODB_URI=mongodb://admin:password@10.33.255.96:27017/draw_and_guess_db
VALKEY_ADDR=10.33.255.96:6379
VALKEY_PASSWORD=your_valkey_password_change_me
