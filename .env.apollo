# Environment variables for Apollo Studio Schema Registry

# Apollo Studio API Key
# Get your key from: https://studio.apollographql.com/user-settings/api-keys
APOLLO_KEY=your-apollo-key-here

# Graph reference (format: graph-name@variant)
APOLLO_GRAPH_REF=draw-and-guess@main

# Optional: Schema file path (default: src/graph/schema-complete.graphqls)
# SCHEMA_FILE=src/graph/schema-complete.graphqls

# Optional: Routing URL (default: http://localhost:8080/graphql)
# ROUTING_URL=http://localhost:8080/graphql
